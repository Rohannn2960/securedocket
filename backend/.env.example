# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Format: mongodb://<username>:<password>@<host>:<port>/<database>
MONGODB_URI=mongodb://localhost:27017/secure_dms_dev

# Authentication Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_REFRESH_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12

# AWS S3 Storage (Server-Side SSE-S3 Encryption)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=REPLACE_WITH_S3_BUCKET_NAME

# AI OCR & Analysis (Server-side Only)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Master Encryption Key
# Must be exactly 64 hex characters (32 bytes)
MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_MASTER_KEY
